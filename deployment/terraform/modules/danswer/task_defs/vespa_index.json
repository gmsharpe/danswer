{
  "name": "vespa_index",
  "image": "vespaengine/vespa:8.277.17",
  "memory": 4096,
  "essential": true,
  "environment": [
    {
      "name": "VESPA_PORT",
      "value": "19071"
    }
  ],
  "portMappings": [
    {
      "containerPort": 19071,
      "hostPort": 19071,
      "protocol": "tcp"
    },
    {
      "containerPort": 8081,
      "hostPort": 8081,
      "protocol": "tcp"
    }
  ],
  "mountPoints": [
    {
      "sourceVolume": "vespa",
      "containerPath": "/opt/vespa/var",
      "readOnly": false
    }
  ],
  "user": "root",
  "privileged": true,
  "logConfiguration": {
    "logDriver": "awslogs",
    "options": {
      "awslogs-group": "/ecs/hybrid-cluster",
      "awslogs-region": "${aws_region}",
      "awslogs-stream-prefix": "vespa-index"
    }
  },
  "healthCheck": {
    "command": [
      "CMD-SHELL",
      "curl -f http://localhost:19071 || exit 1"
    ],
    "interval": 10,
    "timeout": 2,
    "retries": 3,
    "startPeriod": 30
  }
}


